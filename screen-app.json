  "verification": {
    "status": "software-preview",
    "hardware_verified": false,
    "notes": [
      "Native Python GTK/Cairo runtime; common/ provides shared drawing, theme, telemetry and scene definitions; scenes/ owns each scenario.",
      "Automotive: dedicated dual-round drive-speed and engine-status panels; demo-only linked speed/gear/RPM/temperature/fuel/voltage/trip data.",
      "Automotive dual480 accepts 60Hz and the observed native ~62.825226Hz without changing hardware modes. Its physical scene acceptance is pending.",
      "Flight/industrial/mixed commands remain compatible; prior physical flight evidence is historical and does not certify the new automotive scene.",
      "No touch or same-content support; no real OBD/vehicle control or automotive live protocol is declared.",
      "PC-monitor scene: simulated linked CPU/GPU workloads or explicit JSON from a monitored computer; missing sensors are unavailable, not invented or replaced with local Pi metrics."
    ],
    "tested_configurations": [
      {
        "date": "2026-11-01",
        "system": "Raspberry Pi OS Bookworm aarch64, labwc/Wayland",
        "connector": "HDMI-A-1",
        "view": "flight",
        "layout": "flight-sbs-480",
        "layout_version": "1.1.0",
        "mode": "960x480@62.825001",
        "panels": "two circular 480x480 panels, one HDMI cable",
        "data_source": "demo",
        "physical_observation": "User confirmed both panels complete, different content, and automatic data motion.",
        "runtime_observation": "GTK layer-shell surface and 960x480 viewport confirmed; ongoing frames/healthy telemetry; get_throttled=0x0.",
        "scope": "One physical setup; no universal SKU matching, touch or long-duration certification."
      }
    ]
  }
