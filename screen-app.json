      "id": "flight",
      "data_sources": [
        "demo"
      ]
    },
    {
      "id": "industrial",
      "data_sources": [
        "demo"
      ]
    },
    {
      "id": "automotive",
      "data_sources": [
        "demo"
      ]
    },
    {
      "id": "pc-monitor",
      "data_sources": [
        "demo",
        "live"
      ]
    }
  ],
  "content_modes": [
    "different"
  ],
  "layouts": [
    "scenes/automotive_industrial/layouts/automotive-industrial-sbs-480.json",
    "scenes/automotive_industrial/layouts/automotive-industrial-sbs-720.json",
    "scenes/automotive_industrial/layouts/automotive-industrial-sbs-800.json",
    "scenes/flight/layouts/flight-sbs-480.json",
    "scenes/flight/layouts/flight-sbs-720.json",
    "scenes/flight/layouts/flight-sbs-800.json",
    "scenes/industrial/layouts/industrial-sbs-480.json",
    "scenes/industrial/layouts/industrial-sbs-720.json",
    "scenes/industrial/layouts/industrial-sbs-800.json",
    "scenes/automotive/layouts/automotive-sbs-480.json",
    "scenes/automotive/layouts/automotive-sbs-720.json",
    "scenes/automotive/layouts/automotive-sbs-800.json",
    "scenes/pc_monitor/layouts/pc-monitor-sbs-480.json",
    "scenes/pc_monitor/layouts/pc-monitor-sbs-720.json",
    "scenes/pc_monitor/layouts/pc-monitor-sbs-800.json"
  ],
  "capabilities": {
    "multi_instance": true,
    "read_only": true
  },
  "runtime": {
    "renderer": "python-gtk-cairo",
    "platform": "linux",
    "desktop": "Bookworm/labwc Wayland with GTK layer-shell",
    "graphical_session_required": true,
    "output_targeting_required": true,
    "output_scale": 1,
    "output_transform": "normal",
    "dependencies": [
      "python3",
      "python3-gi",
      "python3-gi-cairo",
      "python3-cairo",
      "gir1.2-gtk-3.0",
      "gir1.2-gtklayershell-0.1",
      "wlr-randr"
